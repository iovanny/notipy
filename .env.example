# Intervalo entre comprobaciones (segundos)
NOTIPY_CHECK_INTERVAL=30

# Umbrales de batería (%)
NOTIPY_HIGH_THRESHOLD=90
NOTIPY_LOW_THRESHOLD=9

# Webhook para notificaciones remotas (opcional)
NOTIPY_WEBHOOK_URL=https://tu-servidor.com/c.php
NOTIPY_CHAT_ID=-123456789

# Archivos de sonido (opcional; requiere ffplay)
NOTIPY_SOUND_STARTUP=/ruta/a/startup.mp3
NOTIPY_SOUND_FULL=/ruta/a/full.m4a
NOTIPY_SOUND_LOW=/ruta/a/low.mp3

# Notificaciones de escritorio con notify-send (Linux)
NOTIPY_DESKTOP_NOTIFICATIONS=true
NOTIPY_STARTUP_NOTIFICATION=true
